# Copy to .env and fill in. Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
# The anon (or publishable) key. Never put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=

# Optional: Meta (Facebook) Pixel ID for ad tracking.
VITE_META_PIXEL_ID=
